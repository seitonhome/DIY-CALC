# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: only needed for server-side admin operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (used for auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Sentry error monitoring. Leave unset to disable — the app builds
# and runs normally without it (see src/instrumentation.ts /
# src/instrumentation-client.ts, which no-op when this is absent).
# NEXT_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
